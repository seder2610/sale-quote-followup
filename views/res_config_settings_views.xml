<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_followup" model="ir.ui.view">
        <field name="name">res.config.settings.form.sale.quote.followup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='quotation_validity_days']" position="after">
                <setting id="sale_quote_followup_setting"
                         string="Relances automatiques des devis"
                         help="Relance progressive des devis envoyés restés sans réponse (cron quotidien).">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="followup_reminder_days" class="col-lg-6 o_light_label"/>
                            <field name="followup_reminder_days" class="text-center" style="width: 3rem;"/>
                        </div>
                        <div class="row mt8">
                            <label for="followup_firm_days" class="col-lg-6 o_light_label"/>
                            <field name="followup_firm_days" class="text-center" style="width: 3rem;"/>
                        </div>
                        <div class="row mt8">
                            <label for="followup_last_days" class="col-lg-6 o_light_label"/>
                            <field name="followup_last_days" class="text-center" style="width: 3rem;"/>
                        </div>
                        <div class="row mt8">
                            <label for="followup_channel" class="col-lg-6 o_light_label"/>
                            <field name="followup_channel"/>
                        </div>
                        <div class="row mt8"
                             invisible="followup_channel == 'email'">
                            <label for="followup_activity_user_id" class="col-lg-6 o_light_label"/>
                            <field name="followup_activity_user_id"
                                   options="{'no_create': True}"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
